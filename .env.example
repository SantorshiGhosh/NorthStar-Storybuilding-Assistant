# Living Story Bible — Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Supabase PostgreSQL or local SQLite for immediate plug-and-play testing)
# For Supabase PostgreSQL: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./story_bible.db

# AI Provider (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Supabase Auth & Storage (Optional for local mode, required for Supabase cloud sync)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=manuscripts

# Encryption Key for AES-256-GCM Manuscript Storage (32-byte hex or base64)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
VAULT_ENCRYPTION_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# Vector Store Path (Persistent ChromaDB)
CHROMA_PERSIST_DIRECTORY=./storage/chroma_db
