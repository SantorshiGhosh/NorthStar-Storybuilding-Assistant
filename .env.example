# ==============================================================================
# Living Story Bible — Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration (FastAPI)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Primary Database URL (Supabase PostgreSQL or local SQLite for immediate plug-and-play testing)
# Example Supabase: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./story_bible.db

# ------------------------------------------------------------------------------
# AI Provider (Google Gemini API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Supabase Configuration (Auth, PostgreSQL RLS, Storage)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Public / Anon Key (supports both SUPABASE_KEY and SUPABASE_ANON_KEY naming conventions)
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_STORAGE_BUCKET=manuscripts

# ------------------------------------------------------------------------------
# Manuscript Confidential Vault Encryption (AES-256-GCM)
# ------------------------------------------------------------------------------
# 32-byte (64 hex characters) encryption key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=5f1d7a8e9b0c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e
VAULT_ENCRYPTION_KEY=5f1d7a8e9b0c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e

# ------------------------------------------------------------------------------
# Vector Store Path (ChromaDB)
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./storage/chroma_db

# ------------------------------------------------------------------------------
# Frontend Vite Environment Variables (Client-Side)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
